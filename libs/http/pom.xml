<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.monorepo.libs</groupId>
    <artifactId>libs</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lib-http</artifactId>
  <name>lib-http</name>
  <description>
    Primitivas HTTP reutilizables: cabeceras estandar, correlation/request id,
    filtros JAX-RS y utilidades de respuesta. Sin logica de negocio.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.example.monorepo.libs</groupId>
      <artifactId>lib-common-core</artifactId>
    </dependency>

    <!--
      Se compila contra las APIs Jakarta, NO contra la extension quarkus-rest.
      Asi la libreria no impone runtime a sus consumidores: es la aplicacion
      la que aporta la extension.
    -->
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>
</project>
